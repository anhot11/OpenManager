// require MT >= 2.26.10
{
    name: ["HTML", ".html", ".htm"]
    ignoreCase: true

    comment: {startsWith: "<!--", endsWith: "-->", addToContains: false}

    bracketPairs: ["<>", "{}", "[]", "()"]

    defines: [
        "phpOpening": /<\?(?:php(?=[ \t\r\n]|\z)|=)/
        "scriptOpening": /<\s*(script)(?=[\s\/>]|/ + include("phpOpening") + /)/
        "scriptJavascriptType": /(?:text\/javascript|application\/javascript|module)?/
        "scriptJsonType": /application\/(?:ld\+)?json|importmap/
        // PHP 字符串、块注释可跨过 ?>；未闭合 PHP 保持到输入末尾。
        "php": {
            start: {match: include("phpOpening"), 0: "!!meta"}
            end: {match: /\?>/, 0: "!!meta"}
            style: "!!default"
            matchEndFirst: false
            childrenSyntax: "PHP-Code"
        }
        "htmlComment": {
            start: {match: /<!--/}
            end: {match: /-->/}
            style: "comment"
            contains: [{include: "php"}]
        }

        // 动态选择器使用不回溯的逐字符前缀；停止条件只在引号外识别真实属性名
        "tagAttributeBeforeType": /(?:(?:"(?:[^"<]++|<(?!\?(?:php(?=[ \t\r\n]|\z)|=)))*+"|'(?:[^'<]++|<(?!\?(?:php(?=[ \t\r\n]|\z)|=)))*+'|(?!(?:[ \t\r\n]+type[ \t\r\n]*=))[^"'<>]))*+/
        // 静态属性按互斥文本块消费；遇到 PHP 则退回逐层解析，避免 PHP 引号截断属性
        "tagAttributeText": /(?:"(?:[^"<]++|<(?!\?(?:php(?=[ \t\r\n]|\z)|=)))*+"|'(?:[^'<]++|<(?!\?(?:php(?=[ \t\r\n]|\z)|=)))*+'|[^"'<>]++)*+/

        // 标签属性的匹配规则
        "tagAttributes": [
            // HTML 注释（可以出现在标签内）
            {include: "htmlComment"}
            {include: "php"}

            // style 属性正文交给 CSS；两种引号分别声明，避免子语法吞掉宿主边界
            {
                start: {match: /(?<!\S)(style)\s*(=\s*)(")/, 1: "attrName", 2: "operator", 3: "string"}
                end: {match: /"/, 0: "string"}
                mustMatchEnd: true
                childrenSyntax: ".css"
            }
            {
                start: {match: /(?<!\S)(style)\s*(=\s*)(')/, 1: "attrName", 2: "operator", 3: "string"}
                end: {match: /'/, 0: "string"}
                mustMatchEnd: true
                childrenSyntax: ".css"
            }

            // xmlns 命名空间声明：xmlns:prefix="uri"
            {match: /(xmlns:)([^='"<>\s]+)/, 1: "attrName", 2: "namespace"}

            // 普通属性名（支持命名空间）：namespace:attrName 或 attrName
            {match: /(?:([^='"<\/>\s]+)(:))?([^='"<\/>\s]+)/, 1: "namespace", 2: "attrName", 3: "attrName"}

            // 普通属性逐层匹配，PHP 内的同类引号和 > 不结束外层属性或标签。
            {match: /=\s*/, 0: "operator"}
            {
                start: {match: /"/}
                end: {match: /"/}
                style: "string"
                contains: [{include: "php"}]
            }
            {
                start: {match: /'/}
                end: {match: /'/}
                style: "string"
                contains: [{include: "php"}]
            }
        ]

        "scriptJavascriptTypeAttribute": {
            match: /(?<!\S)(type)([ \t\r\n]*=[ \t\r\n]*)((['"]?)/ + include("scriptJavascriptType") + /\4)(?=[ \t\r\n>]|\/>)/
            1: "attrName"
            2: "operator"
            3: "string"
        }
        "scriptJsonTypeAttribute": {
            match: /(?<!\S)(type)([ \t\r\n]*=[ \t\r\n]*)((['"]?)(?:/ + include("scriptJsonType") + /)\4)(?=[ \t\r\n>]|\/>)/
            1: "attrName"
            2: "operator"
            3: "string"
        }
        "scriptTypeAssignment": {match: /(?<!\S)type[ \t\r\n]*=/}
        "tagOpeningTail": {
            start: {match: /(?=[ \t\r\n>]|\/>)/}
            end: {match: />/}
            mustMatchEnd: true
            contains: [
                {match: /\/>/} => FAIL
                {include: "tagAttributes"}
            ]
        }

        // HTML 实体引用
        "entityReferences": [
            // 常见命名实体
            {match: /&(?:amp|gt|lt|quot|apos|nbsp|copy|reg|trade|euro|cent|pound|yen|deg|plusmn|times|divide|hellip|mdash|ndash|lsquo|rsquo|ldquo|rdquo|bull|middot|sect|para|dagger|Dagger|permil|prime|Prime|lsaquo|rsaquo|oline|frasl|weierp|image|real|alefsym|larr|uarr|rarr|darr|harr|crarr|lArr|uArr|rArr|dArr|hArr|forall|part|exist|empty|nabla|isin|notin|ni|prod|sum|minus|lowast|radic|prop|infin|ang|and|or|cap|cup|int|there4|sim|cong|asymp|ne|equiv|le|ge|sub|sup|nsub|sube|supe|oplus|otimes|perp|sdot|lceil|rceil|lfloor|rfloor|lang|rang|loz|spades|clubs|hearts|diams);/, 0: "strEscape"}

            // 数字实体（十进制）
            {match: /&#\d+;/, 0: "strEscape"}

            // 数字实体（十六进制）
            {match: /&#x[0-9a-fA-F]+;/, 0: "strEscape"}

            // 错误的实体引用（缺少分号或不存在的实体名）
            {match: /&[a-zA-Z0-9#]*;?/, 0: "error"}
        ]
    ]

    contains: [
        {include: "php"}
        {include: "htmlComment"}

        // DOCTYPE 声明
        {
            start: {match: /<!(DOCTYPE|doctype)\b/, 1: "keyword"}
            end: {match: />|$/}
            style: "meta"
            contains: [
                {match: /(PUBLIC|SYSTEM|"[^"]*"|'[^']*')/, 0: "string"}
            ]
        }

        // CDATA 区块
        {
            start: {match: /<!\[CDATA\[/}
            end: {match: /\]\]>|$/}
            style: "string"
        }

        // 常见 script type 按真实 HTML 用法选择语言；未知值保持缺失回退
        {
            start: {
                match: /<\s*(script)(?=[\s\/>])(/ + include("tagAttributeBeforeType") + /[ \t\r\n]+type[ \t\r\n]*=[ \t\r\n]*(["']?)([^"'<>]*?)\3(?=[ \t\r\n>]|\/>)/ + include("tagAttributeText") + /)(?<!\/)>/
                1: "tagName"
                2: {include: "tagAttributes"}
            }
            end: {match: /<\/\s*(script)\s*>/, 1: "tagName"}
            childrenSyntax: {
                capture: 4
                "" => ".js"
                "text/javascript" => ".js"
                "application/javascript" => ".js"
                "module" => ".js"
                "application/json" => ".json"
                "application/ld+json" => ".json"
                "importmap" => ".json"
            }
        }

        // 未声明动态选择器的 script 正文使用 JavaScript
        {
            start: {
                match: /<\s*(script)(?=[\s\/>])(/ + include("tagAttributeText") + /)(?<!\/)>/
                1: "tagName"
                2: {include: "tagAttributes"}
            }
            end: {match: /<\/\s*(script)\s*>/, 1: "tagName"}
            childrenSyntax: ".js"
        }

        // style 正文固定使用 CSS
        {
            start: {
                match: /<\s*(style)(?=[\s\/>])(/ + include("tagAttributeText") + /)(?<!\/)>/
                1: "tagName"
                2: {include: "tagAttributes"}
            }
            end: {match: /<\/\s*(style)\s*>/, 1: "tagName"}
            childrenSyntax: ".css"
        }

        // 引号属性内的 PHP 不改变属性名；逐层寻找第一个静态 type，保留 JSON 路由。
        {
            start: {
                group: linkAll
                contains: [
                    {
                        start: {match: include("scriptOpening"), 1: "tagName"}
                        end: {include: "scriptJsonTypeAttribute"}
                        mustMatchEnd: true
                        contains: [
                            {match: /\/?>/} => FAIL
                            {include: "scriptTypeAssignment"} => FAIL
                            {include: "php"} => FAIL
                            {include: "tagAttributes"}
                        ]
                    }
                    {include: "tagOpeningTail"}
                ]
            }
            end: {match: /<\/\s*(script)\s*>/, 1: "tagName"}
            childrenSyntax: ".json"
        }

        // 未声明 type 或显式 JavaScript 时，nonce 等普通属性内的 PHP 不影响正文语言。
        {
            start: {
                group: linkAll
                contains: [
                    {
                        start: {match: include("scriptOpening"), 1: "tagName"}
                        end: {
                            group: select
                            contains: [
                                {include: "scriptJavascriptTypeAttribute"}
                                {match: /(?=>)/}
                            ]
                        }
                        mustMatchEnd: true
                        contains: [
                            {match: /\/>/} => FAIL
                            {include: "scriptTypeAssignment"} => FAIL
                            {include: "php"} => FAIL
                            {include: "tagAttributes"}
                        ]
                    }
                    {include: "tagOpeningTail"}
                ]
            }
            end: {match: /<\/\s*(script)\s*>/, 1: "tagName"}
            childrenSyntax: ".js"
        }

        // 动态 type 或整段属性注入无法静态选定语言；隔离原始正文，不注入 PHP。
        {
            start: {
                start: {match: include("scriptOpening"), 1: "tagName"}
                end: {match: />/}
                contains: [
                    {match: /\/>/} => FAIL
                    {include: "tagAttributes"}
                ]
            }
            end: {match: /<\/\s*(script)\s*>/, 1: "tagName"}
        }

        // style 正文固定为 CSS，普通属性或整段属性中的 PHP 不改变这一入口。
        {
            start: {
                start: {match: /<\s*(style)(?=[\s\/>]|/ + include("phpOpening") + /)/, 1: "tagName"}
                end: {match: />/}
                contains: [
                    {match: /\/>/} => FAIL
                    {include: "tagAttributes"}
                ]
            }
            end: {match: /<\/\s*(style)\s*>/, 1: "tagName"}
            childrenSyntax: ".css"
        }

        // pre 标签（预格式化文本）
        {
            start: {
                start: {match: /<\s*(pre)\b/, 1: "tagName"}
                end: {match: />|$/}
                contains: [{include: "tagAttributes"}]
            }
            end: {match: /<\/\s*(pre)\s*>/, 1: "tagName"}
            contains: [{include: "php"} {include: "entityReferences"}]
        }

        // XML 处理指令：<?xml ... ?>
        {
            start: {match: /<\?([^\s\/>]+)/, 1: "keyword"}
            end: {match: /\?>|$/}
            style: "meta"
            contains: [{include: "tagAttributes"}]
        }

        // 自闭合标签和开始标签：<tagName ... /> 或 <tagName ... >
        // 允许 < 和标签名之间有空格，支持命名空间
        {
            start: {match: /<\s*([^\s<>\/]+)/, 1: "tagName"}
            end: {match: /\/?>|$/}
            contains: [{include: "tagAttributes"}]
        }

        // 结束标签：</tagName>
        // 允许 </ 和标签名之间有空格，以及标签名和 > 之间有空格
        {match: /<\/\s*([^\s>]+)\s*>/, 1: "tagName"}

        // HTML 实体引用
        {include: "entityReferences"}
    ]

    codeFormatter: #BUILT_IN_HTML_FORMATTER#
    codeShrinker: #BUILT_IN_HTML_SHRINKER#
}
