<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ OpenManager - MT-Style Dual Pane Activity Layout
  ~ Unified Top Toolbar, Split Panels, MT-Style Bottom Bar, and Activity DrawerLayout.
  -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Activity Main Content -->
    <LinearLayout
        android:id="@+id/activityRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#151515"
        android:fitsSystemWindows="true">

        <!-- 1. Top Unified MT-Style Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#151515"
            app:navigationIcon="@drawable/menu_icon_control_normal_24dp"
            app:navigationIconTint="@android:color/white"
            app:navigationContentDescription="@string/open_navigation_drawer"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEnd="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/layoutPathTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?selectableItemBackground"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvPathTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="/storage/emulated/0/" />

                    <TextView
                        android:id="@+id/tvStatsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="10.5sp"
                        android:textColor="#909090"
                        android:text="Cargando..." />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMainMore"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/more_vertical_icon_white_24dp"
                    android:contentDescription="Más opciones"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 2. Panels Container (Horizontal Split for Dual Pane) -->
        <LinearLayout
            android:id="@+id/panelsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <me.zhanghai.android.files.ui.ExactFrameLayout
                android:id="@+id/containerPanelA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#363636" />

            <View
                android:id="@+id/paneDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#1D1D1D" />

            <me.zhanghai.android.files.ui.ExactFrameLayout
                android:id="@+id/containerPanelB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#242424" />
        </LinearLayout>

        <!-- 3. MT-Style Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#202020">

            <!-- Normal Mode: [<] [>] [+] [⇆] [↑] -->
            <LinearLayout
                android:id="@+id/bottomBarNormal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBottomBack"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_back_chevron_white_24dp"
                    android:contentDescription="Atrás"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomForward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_forward_chevron_white_24dp"
                    android:contentDescription="Adelante"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomAdd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/add_icon_white_24dp"
                    android:contentDescription="Nuevo"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomSwap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mt_swap"
                    android:contentDescription="Intercambiar Paneles"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnBottomUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/arrow_up_icon_white_24dp"
                    android:contentDescription="Subir Carpeta"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Selection Mode: [Todo] [Copiar ->] [Mover ->] [Borrar] [Más...] -->
            <LinearLayout
                android:id="@+id/bottomBarSelection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Todo"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvertSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Invertir"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyOpposite"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Copiar ➔"
                    android:textColor="#42A5F5"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoveOpposite"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Mover ➔"
                    android:textColor="#42A5F5"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Borrar"
                    android:textColor="#EF5350"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoreSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:singleLine="true"
                    android:text="Más..."
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- MT-Style Navigation Drawer (Sliding 300dp from start) -->
    <LinearLayout
        android:id="@+id/navigationDrawerView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#303030"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Drawer Header (56dp, #151515) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#151515"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_openmanager_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenManager"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Source Edition"
                    android:textColor="#888888"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDrawerSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/settings_icon_white_24dp"
                app:tint="@android:color/white"
                android:contentDescription="Ajustes" />
        </LinearLayout>

        <!-- Drawer Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <!-- Section: Local -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Local"
                    android:textColor="#888888"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Root Directory Item -->
                <LinearLayout
                    android:id="@+id/drawerItemRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/device_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Directorio Raíz"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <ProgressBar
                            android:id="@+id/progressRootStorage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:progress="100"
                            android:progressTint="#2196F3" />

                        <TextView
                            android:id="@+id/tvRootStorageStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ (Raíz del sistema)"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Internal Storage Directory Item -->
                <LinearLayout
                    android:id="@+id/drawerItemInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/sd_card_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Almacenamiento Interno"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <ProgressBar
                            android:id="@+id/progressInternalStorage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:progress="80"
                            android:progressTint="#2196F3" />

                        <TextView
                            android:id="@+id/tvInternalStorageStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/storage/emulated/0"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Downloads Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemDownloads"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/download_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Descargas"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/storage/emulated/0/Download"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Android/data Shortcut -->
                <LinearLayout
                    android:id="@+id/drawerItemAndroidData"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/directory_icon_white_24dp"
                            app:tint="#42A5F5" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Android/data"
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Datos de aplicaciones (Android/data)"
                            android:textColor="#888888"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dynamic User-Added Storages Container -->
                <LinearLayout
                    android:id="@+id/layoutCustomStorages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Add Storage Item (SAF / Document Tree) -->
                <LinearLayout
                    android:id="@+id/drawerItemAddStorage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/add_icon_white_24dp"
                            app:tint="#42A5F5" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Añadir almacenamiento"
                        android:textColor="#42A5F5"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Section: Tools -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Herramientas"
                    android:textColor="#888888"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- APK Tools / Apktool -->
                <LinearLayout
                    android:id="@+id/drawerItemApktool"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_open_as_apk"
                            app:tint="#4CAF50" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Herramientas APK / Apktool"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Installed Apps (MT Manager Extractor) -->
                <LinearLayout
                    android:id="@+id/drawerItemInstalledApps"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/file_apk_icon"
                            app:tint="#4CAF50" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/navigation_installed_apps"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Text Editor -->
                <LinearLayout
                    android:id="@+id/drawerItemTextEditor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/file_text_icon"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Editor de Texto"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Remote Manager (FTP Server) -->
                <LinearLayout
                    android:id="@+id/drawerItemFtp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/computer_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Administrador Remoto (FTP)"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Terminal -->
                <LinearLayout
                    android:id="@+id/drawerItemTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/terminal_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Terminal"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Recycle Bin (Papelera de reciclaje) -->
                <LinearLayout
                    android:id="@+id/drawerItemRecycleBin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/delete_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/settings_category_recycle_bin_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Settings -->
                <LinearLayout
                    android:id="@+id/drawerItemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/settings_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Ajustes"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:id="@+id/drawerItemAbout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/drawer_icon_circle">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/about_icon_white_24dp"
                            app:tint="#DCDCDC" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Acerca de OpenManager"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
