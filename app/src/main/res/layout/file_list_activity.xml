<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ OpenManager - MT-Style Dual Pane Activity Layout
  ~ Unified Top Toolbar, Split Panels, and MT-Style Bottom Bar.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151515"
    android:fitsSystemWindows="true">

    <!-- 1. Top Unified MT-Style Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#151515"
        app:navigationIcon="@drawable/menu_icon_control_normal_24dp"
        app:navigationIconTint="@android:color/white"
        app:navigationContentDescription="@string/open_navigation_drawer"
        app:popupTheme="?actionBarPopupTheme">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvPathTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="/storage/emulated/0/" />

            <TextView
                android:id="@+id/tvStatsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#909090"
                android:text="Cargando..." />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- 2. Panels Container (Horizontal Split for Dual Pane) -->
    <LinearLayout
        android:id="@+id/panelsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <me.zhanghai.android.files.ui.ExactFrameLayout
            android:id="@+id/containerPanelA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#363636" />

        <View
            android:id="@+id/paneDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1D1D1D" />

        <me.zhanghai.android.files.ui.ExactFrameLayout
            android:id="@+id/containerPanelB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#242424" />
    </LinearLayout>

    <!-- 3. MT-Style Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#202020">

        <!-- Normal Mode: [<] [>] [+] [⇆] [↑] -->
        <LinearLayout
            android:id="@+id/bottomBarNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBottomBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/arrow_back_chevron_white_24dp"
                android:contentDescription="Atrás"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnBottomForward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/arrow_forward_chevron_white_24dp"
                android:contentDescription="Adelante"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnBottomAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/add_icon_white_24dp"
                android:contentDescription="Nuevo"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnBottomSwap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mt_swap"
                android:contentDescription="Intercambiar Paneles"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnBottomUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/arrow_up_icon_white_24dp"
                android:contentDescription="Subir Carpeta"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Selection Mode: [Todo] [Copiar ->] [Mover ->] [Borrar] [Más...] -->
        <LinearLayout
            android:id="@+id/bottomBarSelection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:singleLine="true"
                android:text="Todo"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyOpposite"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:singleLine="true"
                android:text="Copiar ➔"
                android:textColor="#42A5F5"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveOpposite"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:singleLine="true"
                android:text="Mover ➔"
                android:textColor="#42A5F5"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSelection"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:singleLine="true"
                android:text="Borrar"
                android:textColor="#EF5350"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoreSelection"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:singleLine="true"
                android:text="Más..."
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
