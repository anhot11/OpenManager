<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#303030"
    android:padding="20dp">

    <!-- Top Bar: Header & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/audio_icon_white_24dp"
            app:tint="#2196F3" />

        <TextView
            android:id="@+id/tvAudioTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Audio"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever" />

        <ImageButton
            android:id="@+id/btnAudioClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/close_icon_white_24dp"
            app:tint="#888888"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAudioSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="-4dp"
        android:text="Reproductor de audio"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <!-- Center Icon / Art -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivAudioArt"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:src="@drawable/file_audio_icon" />
    </FrameLayout>

    <!-- Progress & Time -->
    <SeekBar
        android:id="@+id/seekBarAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:progressTint="#2196F3"
        android:thumbTint="#2196F3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvAudioElapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAudioDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <ImageButton
            android:id="@+id/btnAudioLoop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_repeat_24dp"
            app:tint="#666666"
            android:contentDescription="Repetir" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/btnAudioRewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_replay_10_24dp"
            app:tint="#FFFFFF"
            android:contentDescription="Retroceder 10s" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <!-- Play/Pause Circle Button -->
        <FrameLayout
            android:id="@+id/btnAudioPlayPause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/badge_background_18dp"
            android:backgroundTint="#2196F3"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAudioPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow_24dp"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <ImageButton
            android:id="@+id/btnAudioForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_forward_10_24dp"
            app:tint="#FFFFFF"
            android:contentDescription="Avanzar 10s" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/btnAudioSpeed"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="1.0x"
            android:textColor="#2196F3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
