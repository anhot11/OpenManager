<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:navigationIcon="@drawable/arrow_back_icon_white_24dp"
            app:title="@string/hex_editor_title"
            app:subtitle="0 B" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search & Replace Collapsible Container -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- Search Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="HEX"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/search_input_background"
                android:fontFamily="monospace"
                android:hint="@string/hex_editor_search_hint"
                android:imeOptions="actionSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:textSize="12.5sp" />

            <CheckBox
                android:id="@+id/cbMatchCase"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Aa"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnSearchPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Anterior"
                android:src="@drawable/ic_arrow_upward_24dp"
                app:tint="#CCCCCC" />

            <ImageButton
                android:id="@+id/btnSearchNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Siguiente"
                android:src="@drawable/ic_arrow_downward_24dp"
                app:tint="#CCCCCC" />

            <ImageButton
                android:id="@+id/btnToggleReplace"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Reemplazar"
                android:src="@drawable/edit_icon"
                app:tint="#CCCCCC" />

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar"
                android:src="@drawable/close_icon_control_normal_24dp"
                app:tint="#CCCCCC" />
        </LinearLayout>

        <!-- Replace Row -->
        <LinearLayout
            android:id="@+id/replaceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etReplace"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/search_input_background"
                android:fontFamily="monospace"
                android:hint="@string/hex_editor_replace_hint"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:textSize="12.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/hex_editor_replace"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/hex_editor_replace_all"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            tools:text="Coincidencia en 0x00000040" />
    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/hsvContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Monospace Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="#1B1B1B"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="OFFSET:  "
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:text="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#383838" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="0123456789ABCDEF"
                        android:textColor="#757575"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHex"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Inspector Panel -->
    <LinearLayout
        android:id="@+id/bottomInspectorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Info and Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSelectionInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="#2196F3"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Offset: 0x00000000 (0)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditByte"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/edit"
                android:textSize="11sp"
                app:icon="@drawable/edit_icon"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyHex"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Hex"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyAscii"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Txt"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Inspector Chips ScrollView -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- HEX -->
                <include
                    android:id="@+id/cardHex"
                    layout="@layout/item_hex_inspector_card" />

                <!-- UInt8 / DEC -->
                <include
                    android:id="@+id/cardDec"
                    layout="@layout/item_hex_inspector_card" />

                <!-- INT8 -->
                <include
                    android:id="@+id/cardInt8"
                    layout="@layout/item_hex_inspector_card" />

                <!-- INT16 LE -->
                <include
                    android:id="@+id/cardInt16"
                    layout="@layout/item_hex_inspector_card" />

                <!-- INT32 LE -->
                <include
                    android:id="@+id/cardInt32"
                    layout="@layout/item_hex_inspector_card" />

                <!-- CHAR -->
                <include
                    android:id="@+id/cardChar"
                    layout="@layout/item_hex_inspector_card" />

                <!-- BINARY -->
                <include
                    android:id="@+id/cardBin"
                    layout="@layout/item_hex_inspector_card" />

                <!-- FLOAT32 -->
                <include
                    android:id="@+id/cardFloat"
                    layout="@layout/item_hex_inspector_card" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
