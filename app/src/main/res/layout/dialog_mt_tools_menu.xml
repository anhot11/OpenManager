<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/mt_card_background"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mt_tools"
            app:tint="#42A5F5"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvToolsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Herramientas"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseTools"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/close_icon_control_normal_24dp"
            app:tint="#9E9E9E"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#383838" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <!-- Dividir archivo -->
            <LinearLayout
                android:id="@+id/toolSplitFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSplitIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_mt_split"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvSplitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Dividir archivo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Unir archivos -->
            <LinearLayout
                android:id="@+id/toolMergeFiles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivMergeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_mt_merge"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvMergeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Unir archivos"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Cifrar archivo -->
            <LinearLayout
                android:id="@+id/toolEncryptFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivEncryptIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/lock_icon_white_24dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvEncryptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Cifrar archivo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Descifrar archivo -->
            <LinearLayout
                android:id="@+id/toolDecryptFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDecryptIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/lock_icon_white_24dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvDecryptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Descifrar archivo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Intercambiar nombres de archivos -->
            <LinearLayout
                android:id="@+id/toolSwapNames"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSwapIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_mt_swap"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvSwapLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Intercambiar nombres de archivos"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Crear enlace simbólico -->
            <LinearLayout
                android:id="@+id/toolCreateSymlink"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSymlinkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/symbolic_link_badge_icon_18dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvSymlinkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Crear enlace simbólico"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Crear acceso directo -->
            <LinearLayout
                android:id="@+id/toolCreateShortcut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivShortcutIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/file_shortcut_icon_foreground"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvShortcutLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Crear acceso directo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Permisos (0777) -->
            <LinearLayout
                android:id="@+id/toolPermissions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPermissionsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/lock_icon_white_24dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvPermissionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Permisos"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Exportar lista de archivos -->
            <LinearLayout
                android:id="@+id/toolExportList"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivExportIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/file_document_icon"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvExportLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Exportar lista de archivos"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Extraer archivo (solo archivos comprimidos) -->
            <LinearLayout
                android:id="@+id/toolExtract"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivExtractIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/extract_icon_control_normal_24dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvExtractLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Extraer archivo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Copiar ruta -->
            <LinearLayout
                android:id="@+id/toolCopyPath"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivCopyPathIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/copy_icon_control_normal_24dp"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvCopyPathLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Copiar ruta"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Descompilar APK (Apktool) -->
            <LinearLayout
                android:id="@+id/toolDecompileApk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivDecompileApkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_open_as_apk"
                    app:tint="#FF9800" />

                <TextView
                    android:id="@+id/tvDecompileApkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Descompilar APK (Apktool)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Recompilar APK (Apktool) -->
            <LinearLayout
                android:id="@+id/toolRecompileApk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivRecompileApkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/file_archive_icon"
                    app:tint="#42A5F5" />

                <TextView
                    android:id="@+id/tvRecompileApkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Recompilar APK (Apktool)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Firmar APK -->
            <LinearLayout
                android:id="@+id/toolSignApk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSignApkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_open_as_signature"
                    app:tint="#4CAF50" />

                <TextView
                    android:id="@+id/tvSignApkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Firmar APK"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Verificar firma -->
            <LinearLayout
                android:id="@+id/toolVerifySignature"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivVerifySignatureIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/shield_icon_white_24dp"
                    app:tint="#AB47BC" />

                <TextView
                    android:id="@+id/tvVerifySignatureLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="Verificar firma"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
