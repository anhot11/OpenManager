        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_file_list_size"
            android:title="@string/settings_file_list_size_title"
            android:defaultValue="@string/pref_default_value_file_list_size"
            android:entries="@array/settings_file_list_size_entries"
            android:entryValues="@array/pref_entry_values_file_list_size"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_max_lines_file_name"
            android:title="@string/settings_max_lines_file_name_title"
            android:defaultValue="@string/pref_default_value_max_lines_file_name"
            android:entries="@array/settings_max_lines_file_name_entries"
            android:entryValues="@array/pref_entry_values_max_lines_file_name"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_file_list_time_preference"
            android:title="@string/settings_file_list_time_preference_title"
            android:defaultValue="@string/pref_default_value_file_list_time_preference"
            android:entries="@array/settings_file_list_time_preference_entries"
            android:entryValues="@array/pref_entry_values_file_list_time_preference"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_disable_permission_in_file_list"
            android:title="@string/settings_disable_permission_in_file_list_title"
            android:summary="@string/settings_disable_permission_in_file_list_summary"
            android:defaultValue="@bool/pref_default_value_disable_permission_in_file_list"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_date_time_format"
            android:title="@string/settings_date_time_format_title"
            android:defaultValue="@string/pref_default_value_date_time_format"
            android:entries="@array/settings_date_time_format_entries"
            android:entryValues="@array/pref_entry_values_date_time_format"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_file_list_animation"
            android:title="@string/settings_file_list_animation_title"
            android:defaultValue="@bool/pref_default_value_file_list_animation"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_file_name_ellipsize"
            android:title="@string/settings_file_name_ellipsize_title"
            android:defaultValue="@string/pref_default_value_file_name_ellipsize"
            android:entries="@array/settings_file_name_ellipsize_entries"
            android:entryValues="@array/pref_entry_values_file_name_ellipsize"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
