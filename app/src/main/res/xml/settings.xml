            android:defaultValue="@string/pref_default_value_bottom_margin_size"
            android:entries="@array/settings_bottom_margin_size_entries"
            android:entryValues="@array/pref_entry_values_bottom_margin_size"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
