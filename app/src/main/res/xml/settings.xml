        <SwitchPreferenceCompat
            android:key="@string/pref_key_preserve_file_time"
            android:title="@string/settings_preserve_file_time_title"
            android:summary="@string/settings_preserve_file_time_summary"
            android:defaultValue="@bool/pref_default_value_preserve_file_time"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_enable_input_box_favorites"
