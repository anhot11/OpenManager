<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 1. STARTUP / INICIO -->
    <PreferenceCategory
        android:title="@string/settings_category_startup_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="@string/pref_key_request_root_permission"
            android:title="@string/settings_request_root_permission_title"
            android:summary="@string/settings_request_root_permission_summary"
            android:defaultValue="@bool/pref_default_value_request_root_permission"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="@string/pref_key_request_shell_permission"
            android:title="@string/settings_request_shell_permission_title"
            android:summary="@string/settings_request_shell_permission_summary"
            android:defaultValue="@bool/pref_default_value_request_shell_permission"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="@string/pref_key_customize_su_command"
            android:title="@string/settings_customize_su_command_title"
            android:summary="@string/settings_customize_su_command_summary"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/pref_key_install_shizuku"
            android:title="@string/settings_install_shizuku_title"
            android:summary="@string/settings_install_shizuku_summary"
            app:iconSpaceReserved="false" />

        <me.zhanghai.android.files.settings.DefaultDirectoryPreference
            android:key="@string/pref_key_file_list_default_directory"
            android:title="@string/settings_startup_path_left_title"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <me.zhanghai.android.files.settings.RightWindowDefaultDirectoryPreference
            android:key="@string/pref_key_file_list_default_directory_right"
            android:title="@string/settings_startup_path_right_title"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_auto_start_services"
            android:title="@string/settings_auto_start_services_title"
            android:defaultValue="@string/pref_default_value_auto_start_services"
            android:entries="@array/settings_auto_start_services_entries"
            android:entryValues="@array/pref_entry_values_auto_start_services"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <me.zhanghai.android.files.settings.RootStrategyPreference
            android:key="@string/pref_key_root_strategy"
            android:title="@string/settings_root_strategy_title"
            android:defaultValue="@string/pref_default_value_root_strategy"
            android:entries="@array/settings_root_strategy_entries"
            android:entryValues="@array/pref_entry_values_root_strategy"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <!-- 2. APPEARANCE / APARIENCIA -->
    <PreferenceCategory
        android:title="@string/settings_category_appearance_title"
        app:iconSpaceReserved="false">

        <rikka.preference.SimpleMenuPreference
            android:key="@string/pref_key_launcher_icon"
