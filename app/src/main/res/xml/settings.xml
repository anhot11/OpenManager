    <!-- 4. RECYCLE BIN / PAPELERA DE RECICLAJE -->
    <PreferenceCategory
        android:title="@string/settings_category_recycle_bin_title"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
