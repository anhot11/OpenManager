            android:summary="@string/settings_enable_input_box_favorites_summary"
            android:defaultValue="@bool/pref_default_value_enable_input_box_favorites"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="@string/pref_key_sort_file_menu"
